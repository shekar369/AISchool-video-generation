# Copy to .env and fill in. Never commit .env.

# --- General -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
RUNS_DIR=runs
OUTPUTS_DIR=outputs

# --- Provider selection (one per stage; "mock" works offline) ----------------
SCRIPT_PROVIDER=mock
STORYBOARD_PROVIDER=mock
VOICE_PROVIDER=mock
VISUALS_PROVIDER=mock
ASSEMBLE_PROVIDER=mock

# --- Provider credentials (only needed for the providers you enable) ---------
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
